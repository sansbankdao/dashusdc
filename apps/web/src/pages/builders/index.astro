---
// src/pages/builders/index.astro
import Layout from '../../layouts/Layout.astro'

const advantages = [
    {
        title: 'Powerful & Simple JS/TS SDK',
        description: 'Integrate USDC into your Node.js applications in minutes. Our SDK simplifies payments, balance queries, and smart contract interactions.',
        icon: 'code'
    },
    {
        title: 'Deep On-Chain Liquidity',
        description: 'Leverage deep liquidity pools on platforms like DashSwap. Your users can easily acquire and trade USDC, ensuring a robust in-app economy.',
        icon: 'liquidity'
    },
    {
        title: 'Tap into a Real-World Economy',
        description: 'Connect your application to a growing network of merchants. Users can spend the USDC they earn in your app at real businesses.',
        icon: 'store'
    },
    {
        title: 'Open & Permissionless',
        description: 'Build on a truly decentralized foundation. USDC is open-source, censorship-resistant, and composable with the entire DeFi ecosystem.',
        icon: 'composable'
    }
];
---

<Layout
    title="Build on Dash USDC | Developer Portal"
    description="Access our powerful JS/TS SDK, deep on-chain liquidity, and a growing ecosystem. Start building the future of finance with USDC."
>
    <main class="py-20">
        <div class="container-custom">
            <!-- Hero Section -->
            <div class="text-center mb-20">
                <h1 class="animate-on-scroll text-4xl md:text-5xl lg:text-6xl font-bold leading-tight">
                    Build the Future of Finance on <span class="gradient-text">Dash USDC</span>
                </h1>
                <p class="animate-on-scroll delay-1 mt-6 text-xl text-gray-600 max-w-3xl mx-auto">
                    Leverage our open-source, stable digital dollar to power your application. Access a powerful SDK, deep on-chain liquidity, and a growing real-world economy.
                </p>
                <div class="animate-on-scroll delay-2 mt-8 flex flex-col sm:flex-row gap-4 justify-center">
                    <a href="#quick-start" class="btn btn-primary">Start Building</a>
                    <a href="https://github.com/sansbankdao" target="_blank" class="btn btn-secondary">View on GitHub</a>
                </div>
            </div>

            <!-- "Why Build with USDC?" Section -->
            <div class="mb-20">
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
                    {advantages.map((advantage, index) => (
                        <div class="bg-white rounded-xl p-8 shadow-sm border border-gray-100 animate-on-scroll" style={`animation-delay: ${index * 0.1}s`}>
                            <div class="h-12 w-12 rounded-lg bg-gradient-to-r from-payflo-purple to-payflo-blue flex items-center justify-center text-white mb-6">
                                {advantage.icon === 'code' && <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline></svg>}
                                {advantage.icon === 'liquidity' && <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22a7 7 0 0 0 7-7c0-2-1-3.9-3-5.5s-3.5-4-5.5-4-4 2.5-5.5 4-3 3.5-3 5.5a7 7 0 0 0 7 7z"></path><path d="M12 22c.9 0 1.8-.1 2.6-.4.8-.3 1.6-.7 2.3-1.2"></path></svg>}
                                {advantage.icon === 'store' && <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8h1a4 4 0 0 1 0 8h-1"></path><path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"></path><line x1="6" y1="1" x2="6" y2="4"></line><line x1="10" y1="1" x2="10" y2="4"></line><line x1="14" y1="1" x2="14" y2="4"></line></svg>}
                                {advantage.icon === 'composable' && <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.6 13.4a1 1 0 0 1-1.2 1.2L5 10l4.4-4.4a1 1 0 0 1 1.2 1.2L8.2 9h7.6a1 1 0 0 1 0 2H8.2l2.4 2.4z"></path><path d="M13.4 10.6a1 1 0 0 1 1.2-1.2L19 14l-4.4 4.4a1 1 0 0 1-1.2-1.2L15.8 15H8.2a1 1 0 0 1 0-2h7.6l-2.4-2.4z"></path></svg>}
                            </div>
                            <h3 class="text-xl font-semibold">{advantage.title}</h3>
                            <p class="mt-3 text-gray-600">{advantage.description}</p>
                        </div>
                    ))}
                </div>
            </div>

            <!-- Start Building Section -->
            <div id="quick-start" class="mb-20">
                <h2 class="text-3xl md:text-4xl font-bold text-center mb-12">
                    Start Building in Minutes
                </h2>
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-start">
                    <!-- Quick Start Code Example -->
                    <div class="bg-gray-800 rounded-xl p-6 shadow-lg">
                        <h3 class="text-xl font-semibold text-white mb-4">Quick Start</h3>
                        <p class="text-gray-400 mb-6">Install our SDK and get the balance of an address in just a few lines of code.</p>
                        <pre class="bg-gray-900 text-white p-4 rounded-lg overflow-x-auto"><code class="language-js">{`// 1. Install the SDK
npm install @dashusdc/sdk

// 2. Use in your project
import { USDCClient } from '@dashusdc/sdk';

const client = new USDCClient('mainnet');

async function getBalance(address) {
  const balance = await client.getBalance(address);
  console.log(\`Balance: \${balance} USDC\`);
}

getBalance('0x...');`}</code></pre>
                    </div>

                    <!-- Core Resources -->
                    <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100">
                        <h3 class="text-xl font-semibold mb-4">Core Resources</h3>
                        <p class="text-gray-600 mb-6">Your go-to links for building with Dash USDC.</p>
                        <ul class="space-y-4">
                            {[
                                { title: 'Developer Documentation', desc: 'In-depth guides and tutorials', url: '/docs' },
                                { title: 'JS/TS SDK on NPM', desc: 'View the official package', url: '#' },
                                { title: 'Smart Contracts on Etherscan', desc: 'Verify our audited contracts', url: '#' },
                                { title: 'Join Developer Chat', desc: 'Get support on Discord', url: '#' }
                            ].map(link => (
                                <li>
                                    <a href={link.url} class="block p-4 rounded-lg hover:bg-gray-50 transition-colors">
                                        <p class="font-semibold text-payflo-blue">{link.title}</p>
                                        <p class="text-sm text-gray-500">{link.desc}</p>
                                    </a>
                                </li>
                            ))}
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Use Case Inspiration -->
            <div>
                <h2 class="text-3xl md:text-4xl font-bold text-center mb-12">
                    What Will You Build?
                </h2>
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 text-center">
                    {[
                        'Global Payroll Platforms',
                        'In-Game Economies',
                        'DeFi & Yield Protocols',
                        'Subscription Services'
                    ].map(useCase => (
                        <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100">
                            <h3 class="text-lg font-semibold">{useCase}</h3>
                        </div>
                    ))}
                </div>
            </div>
        </div>
    </main>
</Layout>
