---
// src/pages/wallets.astro
import Layout from '../layouts/Layout.astro'

// --- Wallet Data ---
// In a real application, this data could come from a CMS or an API.
// We're using placeholder names. Replace them with the actual wallets you partner with.

const recommendedWallets = [
    {
        name: 'Flow Wallet',
        description: 'The best choice for everyday spending, receiving payments, and easy point-of-sale use by merchants.',
        logoUrl: '/logos/flow-wallet-logo.png', // Example path
        links: [
            { platform: 'iOS', url: '#' },
            { platform: 'Android', url: '#' },
        ]
    },
    {
        name: 'Volt Wallet',
        description: 'A powerful desktop and mobile wallet with advanced features for managing your DeFi portfolio and USDC savings.',
        logoUrl: '/logos/volt-wallet-logo.png',
        links: [
            { platform: 'iOS', url: '#' },
            { platform: 'Android', url: '#' },
            { platform: 'Desktop', url: '#' },
        ]
    }
];

const advancedWallets = [
    {
        name: 'Ledger Hardware Wallet',
        description: 'The gold standard for security. Store your USDC offline in cold storage, ideal for large amounts and long-term savings.',
        logoUrl: '/logos/ledger-logo.png',
        links: [
            { platform: 'Official Site', url: '#' },
        ]
    },
    {
        name: 'Safe (Gnosis Safe)',
        description: 'For businesses and DAOs. Requires multiple signatures to approve transactions, providing institutional-grade security.',
        logoUrl: '/logos/safe-logo.png',
        links: [
            { platform: 'Official Site', url: '#' },
        ]
    }
];
---
<Layout
    title="Choose Your USDC Wallet | Dash USDC"
    description="Find a secure, recommended wallet to start sending, receiving, and saving Dash USDC. Options for mobile, desktop, and hardware wallets."
>
    <main>
        <!-- Hero Section -->
        <section class="pt-20 pb-16 md:pt-28 md:pb-24">
            <div class="container-custom text-center">
                <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold leading-tight">
                    Your Gateway to <span class="gradient-text">Dash USDC</span>
                </h1>
                <p class="mt-6 text-xl text-gray-600 max-w-3xl mx-auto">
                    A wallet is your personal interface to the USDC network. Choose a secure, self-custody wallet below to take full control of your digital dollars.
                </p>
            </div>
        </section>

        <!-- SECURITY WARNING -->
        <section class="pb-16 md:pb-24">
            <div class="container-custom">
                <div class="max-w-4xl mx-auto bg-yellow-50 border-l-4 border-yellow-400 p-6 rounded-r-lg">
                    <div class="flex items-start">
                        <div class="flex-shrink-0">
                            <svg class="h-6 w-6 text-yellow-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
                        </div>
                        <div class="ml-4">
                            <h3 class="text-lg font-bold text-yellow-800">Your Security is Your Responsibility</h3>
                            <p class="mt-1 text-yellow-700">
                                Never share your "Secret Recovery Phrase" or "Private Key" with anyone. USDC staff will <span class="font-bold">never</span> ask for it. Anyone who does is a scammer.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Recommended Wallets Section -->
        <section class="pb-16 md:pb-24 bg-gray-50/50 py-20">
            <div class="container-custom">
                <h2 class="text-3xl md:text-4xl font-bold text-center mb-16">
                    Mobile & Desktop Wallets
                </h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl mx-auto">
                    {recommendedWallets.map(wallet => (
                        <div class="bg-white rounded-xl shadow-lg p-8 flex flex-col">
                            <div class="flex items-center mb-4">
                                <!-- Placeholder for Logo -->
                                <div class="h-16 w-16 bg-gray-200 rounded-full mr-6 flex items-center justify-center font-bold text-gray-500">Logo</div>
                                <h3 class="text-2xl font-bold">{wallet.name}</h3>
                            </div>
                            <p class="text-gray-600 flex-grow">{wallet.description}</p>
                            <div class="mt-6 grid grid-cols-2 sm:grid-cols-3 gap-3">
                                {wallet.links.map(link => (
                                    <a href={link.url} class="btn btn-secondary flex items-center justify-center text-sm">
                                        {link.platform === 'iOS' && <svg class="h-5 w-5 mr-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 8.12a4 4 0 0 1 4 4M16 8.12a4 4 0 0 0-4-4m4 4H8m0 0a4 4 0 1 0 0 8h8a4 4 0 1 0 0-8h-1a4 4 0 1 0-4 4"></path></svg>}
                                        {link.platform === 'Android' && <svg class="h-5 w-5 mr-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 18a1 1 0 0 1-1-1v-2.34c0-1.05.5-2.02 1.34-2.66h.02c.84-.64 1.34-1.61 1.34-2.66V7a1 1 0 0 1 1-1h1v1h-1v2.34c0 .94-.42 1.83-1.12 2.44l-.16.14c-.7.6-1.12 1.5-1.12 2.44V17a1 1 0 0 1-1 1zm-6-1a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1v-2.34c0-1.05.5-2.02 1.34-2.66h.02c.84-.64 1.34-1.61 1.34-2.66V7a1 1 0 0 1 1-1h1v1h-1v2.34c0 .94-.42 1.83-1.12 2.44l-.16.14c-.7.6-1.12 1.5-1.12 2.44V17z"></path></svg>}
                                        {link.platform === 'Desktop' && <svg class="h-5 w-5 mr-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg>}
                                        {link.platform}
                                    </a>
                                ))}
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </section>

        <!-- Advanced Wallets Section -->
        <section class="pb-16 md:pb-24">
            <div class="container-custom">
                <h2 class="text-3xl md:text-4xl font-bold text-center mb-16">
                    Advanced Security
                </h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl mx-auto">
                    {advancedWallets.map(wallet => (
                        <div class="bg-white rounded-xl shadow-lg p-8 flex flex-col">
                            <div class="flex items-center mb-4">
                                <div class="h-16 w-16 bg-gray-200 rounded-full mr-6 flex items-center justify-center font-bold text-gray-500">Logo</div>
                                <h3 class="text-2xl font-bold">{wallet.name}</h3>
                            </div>
                            <p class="text-gray-600 flex-grow">{wallet.description}</p>
                            <div class="mt-6">
                                {wallet.links.map(link => (
                                    <a href={link.url} class="btn btn-primary w-full">Visit {link.platform}</a>
                                ))}
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </section>

        <!-- Important Considerations Section -->
        <section class="pb-20">
            <div class="container-custom max-w-5xl mx-auto">
                <div class="text-center">
                    <h2 class="text-3xl md:text-4xl font-bold">Important Considerations</h2>
                </div>
                <div class="mt-12 space-y-8">
                    <div class="p-6 bg-white rounded-lg shadow-sm">
                        <h3 class="text-xl font-semibold">Self-Custody vs. Custodial</h3>
                        <p class="mt-2 text-gray-600">All wallets recommended here are <span class="font-bold">self-custody</span> (or non-custodial), meaning you—and only you—have control over your funds. This is different from an exchange, where the company holds your money for you. With self-custody, you are your own bank.</p>
                    </div>
                    <div class="p-6 bg-white rounded-lg shadow-sm">
                        <h3 class="text-xl font-semibold">Back Up Your Wallet!</h3>
                        <p class="mt-2 text-gray-600">When you create a wallet, you will be given a 12 or 24-word "Secret Recovery Phrase." Write this down on paper and store it in a safe, offline location. This phrase is the master key to your funds. If you lose your device, you can use this phrase to restore access. If you lose the phrase, you lose your money forever.</p>
                    </div>
                </div>
            </div>
        </section>

    </main>
</Layout>
