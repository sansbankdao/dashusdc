---
// src/pages/transparency/reserves.astro
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Proof of Reserves | Dash USDC">
    <main>
        <!-- Hero Section -->
        <section class="pt-20 pb-16 md:pt-28 md:pb-24">
            <div class="container-custom text-center">
                <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold leading-tight">
                    Proof of <span class="gradient-text">Reserves</span>
                </h1>
                <p class="mt-6 text-xl text-gray-600 max-w-3xl mx-auto">
                    Every USDC is backed by a diversified basket of high-quality assets. Below is a real-time, detailed breakdown of our reserves, updated every 15 minutes.
                </p>
                <p class="mt-4 text-sm text-gray-500">
                    Last Updated: November 4, 2025, 14:30 UTC
                </p>
            </div>
        </section>

        <!-- Key Metrics -->
        <section class="pb-16 md:pb-24">
            <div class="container-custom">
                <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                    <div class="feature-card text-center">
                        <h3 class="text-lg font-semibold text-gray-600 mb-2">Total USDC Supply</h3>
                        <p class="text-4xl font-bold">1,234,567,890</p>
                    </div>
                    <div class="feature-card text-center">
                        <h3 class="text-lg font-semibold text-gray-600 mb-2">Total Reserve Value</h3>
                        <p class="text-4xl font-bold">$1,299,876,543</p>
                    </div>
                    <div class="feature-card text-center">
                        <h3 class="text-lg font-semibold text-gray-600 mb-2">Collateralization Ratio</h3>
                        <p class="text-4xl font-bold text-green-600">105.29%</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Reserve Breakdown Section -->
        <section class="pb-16 md:pb-24 bg-gray-50/50 py-20">
            <div class="container-custom">
                <h2 class="text-3xl md:text-4xl font-bold text-center mb-12">
                    Reserve Asset Allocation
                </h2>
                <div class="grid grid-cols-1 lg:grid-cols-3 gap-12 items-start">
                    <!-- Table of Assets -->
                    <div class="lg:col-span-2 bg-white rounded-xl shadow-lg p-1 overflow-hidden">
                        <div class="overflow-x-auto">
                            <table class="w-full text-left">
                                <thead class="bg-gray-50 border-b">
                                    <tr>
                                        <th class="px-6 py-4 font-medium text-gray-600">Asset</th>
                                        <th class="px-6 py-4 font-medium text-gray-600 text-right">Value (USD)</th>
                                        <th class="px-6 py-4 font-medium text-gray-600 text-right">% of Total</th>
                                        <th class="px-6 py-4 font-medium text-gray-600">Proof</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr class="border-b">
                                        <td class="px-6 py-4 font-semibold">USD Stablecoin Reserves</td>
                                        <td class="px-6 py-4 text-right tabular-nums">$650,123,456</td>
                                        <td class="px-6 py-4 text-right tabular-nums">50.01%</td>
                                        <td class="px-6 py-4"><a href="#" class="text-payflo-blue hover:underline">Address</a></td>
                                    </tr>
                                    <tr class="border-b">
                                        <td class="px-6 py-4 font-semibold">US Treasury Bills (Tokenized)</td>
                                        <td class="px-6 py-4 text-right tabular-nums">$401,234,567</td>
                                        <td class="px-6 py-4 text-right tabular-nums">30.87%</td>
                                        <td class="px-6 py-4"><a href="#" class="text-payflo-blue hover:underline">Custodian</a></td>
                                    </tr>
                                    <tr class="border-b">
                                        <td class="px-6 py-4 font-semibold">Wrapped Bitcoin (WBTC)</td>
                                        <td class="px-6 py-4 text-right tabular-nums">$129,543,210</td>
                                        <td class="px-6 py-4 text-right tabular-nums">9.97%</td>
                                        <td class="px-6 py-4"><a href="#" class="text-payflo-blue hover:underline">Address</a></td>
                                    </tr>
                                    <tr>
                                        <td class="px-6 py-4 font-semibold">Ether (ETH)</td>
                                        <td class="px-6 py-4 text-right tabular-nums">$118,975,310</td>
                                        <td class="px-6 py-4 text-right tabular-nums">9.15%</td>
                                        <td class="px-6 py-4"><a href="#" class="text-payflo-blue hover:underline">Address</a></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Chart Placeholder and Audits -->
                    <div class="space-y-8">
                        <div class="feature-card">
                            <h3 class="text-xl font-semibold mb-3">Asset Distribution</h3>
                            <!-- Placeholder for a pie chart -->
                            <div class="w-full h-48 bg-gray-100 rounded-lg flex items-center justify-center">
                                <p class="text-gray-500">Pie chart visualization</p>
                            </div>
                            <p class="text-sm text-gray-500 mt-3">This chart visualizes the current allocation of assets held in reserve.</p>
                        </div>
                        <div class="feature-card">
                            <h3 class="text-xl font-semibold mb-3">Third-Party Attestations</h3>
                            <p class="text-gray-600 mb-4">Our reserves are regu
