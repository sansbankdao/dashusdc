---
// src/pages/governance/index.astro
import Layout from '../../layouts/Layout.astro';

// Example data for proposals
const proposals = [
    {
        id: 'DIP-007',
        title: 'Adjust Stability Fee to 0.5%',
        status: 'Active',
        summary: 'This proposal suggests adjusting the stability fee from 0.25% to 0.5% to increase protocol revenue and strengthen the treasury.',
        forVotes: 7_200_000,
        againstVotes: 1_800_000,
        totalVotes: 10_000_000
    },
    {
        id: 'DIP-006',
        title: 'Onboard Wrapped SOL as a New Collateral Type',
        status: 'Passed',
        summary: 'To diversify the reserve, this proposal recommends adding Wrapped Solana (wSOL) as an approved collateral asset with a 150% collateralization ratio.',
        forVotes: 9_500_000,
        againstVotes: 500_000,
        totalVotes: 10_000_000
    },
    {
        id: 'DIP-005',
        title: 'Fund Development of a Mobile Wallet',
        status: 'Executed',
        summary: 'A treasury grant of 500,000 USDC was approved to fund the development of a native mobile wallet for iOS and Android.',
        forVotes: 8_100_000,
        againstVotes: 1_200_000,
        totalVotes: 10_000_000
    }
];

const getStatusClass = (status) => {
    switch (status) {
        case 'Active': return 'bg-blue-100 text-blue-800';
        case 'Passed': return 'bg-green-100 text-green-800';
        case 'Executed': return 'bg-purple-100 text-purple-800';
        default: return 'bg-gray-100 text-gray-800';
    }
}
---

<Layout title="Governance Portal | Dash USDC">
    <main>
        <!-- Hero Section -->
        <section class="pt-20 pb-16 md:pt-28 md:pb-24">
            <div class="container-custom">
                <div class="text-center">
                    <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold leading-tight">
                        USDC <span class="gradient-text">Governance Portal</span>
                    </h1>
                    <p class="mt-6 text-xl text-gray-600 max-w-3xl mx-auto">
                        Shape the future of Dash USDC. Review proposals, delegate your votes, and participate in building a truly decentralized stablecoin.
                    </p>
                    <div class="mt-8 flex justify-center gap-4">
                        <a href="#" class="btn btn-primary">Connect Wallet to Vote</a>
                        <a href="#" class="btn btn-secondary">Create a Proposal</a>
                    </div>
                </div>
            </div>
        </section>

        <!-- Proposals Section -->
        <section class="pb-16 md:pb-24 bg-gray-50 py-20">
            <div class="container-custom">
                <h2 class="text-3xl md:text-4xl font-bold text-center mb-12">
                    Community Proposals
                </h2>

                <div class="space-y-6">
                    {proposals.map(prop => (
                        <div class="feature-card !p-6">
                            <div class="flex flex-col sm:flex-row justify-between sm:items-center mb-4">
                                <h3 class="text-2xl font-semibold">{prop.id}: {prop.title}</h3>
                                <span class={`text-sm font-medium px-3 py-1 rounded-full mt-2 sm:mt-0 ${getStatusClass(prop.status)}`}>
                                    {prop.status}
                                </span>
                            </div>
                            <p class="text-gray-600 mb-6">{prop.summary}</p>

                            {prop.status === 'Active' && (
                                <div class="mb-4">
                                    <div class="flex justify-between text-sm font-medium mb-1">
                                        <span class="text-green-600">For: {(prop.forVotes / 1e6).toFixed(1)}M</span>
                                        <span class="text-red-600">Against: {(prop.againstVotes / 1e6).toFixed(1)}M</span>
                                    </div>
                                    <div class="w-full bg-gray-200 rounded-full h-2.5">
                                        <div class="bg-gradient-to-r from-green-400 to-blue-500 h-2.5 rounded-full" style={`width: ${(prop.forVotes / prop.totalVotes) * 100}%`}></div>
                                    </div>
                                </div>
                            )}

                            <a href={`/governance/proposal/${prop.id}`} class="text-payflo-blue font-semibold hover:underline">
                                View Details & Discussion →
                            </a>
                        </div>
                    ))}
                </div>
            </div>
        </section>
    </main>
</Layout>
