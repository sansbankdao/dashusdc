---
// src/pages/learn/index.astro
import Layout from '../../layouts/Layout.astro'

const featuredGuides = [
    {
        title: 'What is a Stablecoin and Why Use One?',
        description: 'Start with the absolute basics. Understand what makes a stablecoin different from other cryptocurrencies.',
        url: '/learn/what-is-a-stablecoin',
        category: 'Beginner'
    },
    {
        title: 'How USDC Stays Stable: A Look at the Mechanism',
        description: 'Trust comes from understanding. Learn about the reserves and mechanisms that keep USDC pegged to the dollar.',
        url: '/learn/usdc-stability',
        category: 'Intermediate'
    },
    {
        title: '5 Essential Tips to Keep Your Crypto Safe',
        description: 'Learn the fundamental security practices to protect your digital assets from scams and theft.',
        url: '/learn/security-basics',
        category: 'Beginner'
    },
    {
        title: 'An Introduction to DeFi (Decentralized Finance)',
        description: 'Discover how you can use USDC to lend, borrow, and earn yield on decentralized platforms.',
        url: '/learn/intro-to-defi',
        category: 'Intermediate'
    }
];

const categories = [
    'Stablecoin Basics',
    'Security Best Practices',
    'DeFi Concepts',
    'Practical Guides',
    'For Merchants',
    'For Builders'
];
---

<Layout
    title="Learning Center | Dash USDC"
    description="Your guide to the new digital economy. Learn the fundamentals of stablecoins, DeFi, security, and how to use Dash USDC safely and effectively."
>
    <main>
        <!-- Hero Section -->
        <section class="pt-20 pb-16 md:pt-28 md:pb-24 overflow-hidden">
            <div class="container-custom">
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
                    <div>
                        <h1 class="animate-on-scroll delay-0 text-4xl md:text-5xl lg:text-6xl font-bold leading-tight">
                            Master the Fundamentals of <span class="gradient-text">Digital Money</span>
                        </h1>
                        <p class="animate-on-scroll delay-1 mt-6 text-xl text-gray-600 max-w-lg">
                            Welcome to the USDC Learning Center. Our goal is to empower you with the knowledge to safely navigate the world of stablecoins, DeFi, and the new digital economy.
                        </p>
                        <div class="animate-on-scroll delay-2 mt-8">
                            <a href="#featured-guides" class="btn btn-primary">
                                Start Learning
                            </a>
                        </div>
                    </div>
                    <div class="animate-on-scroll delay-3">
                        <div class="relative">
                            <div class="absolute -inset-0.5 bg-gradient-to-r from-payflo-purple to-payflo-blue rounded-xl blur opacity-30"></div>
                            <div class="relative bg-white rounded-xl shadow-xl overflow-hidden p-8">
                                <div class="space-y-6">
                                    {[
                                        { title: 'Core Concepts', desc: 'Understand the "what" and "why".', icon: 'book' },
                                        { title: 'Practical Guides', desc: 'Step-by-step "how-to" tutorials.', icon: 'compass' },
                                        { title: 'Safety First', desc: 'Learn to protect your assets.', icon: 'shield' }
                                    ].map(item => (
                                        <div class="flex items-center gap-4">
                                            <div class="w-12 h-12 bg-purple-100 rounded-lg flex items-center justify-center">
                                                {item.icon === 'book' && <svg class="w-6 h-6 text-payflo-purple" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>}
                                                {item.icon === 'compass' && <svg class="w-6 h-6 text-payflo-purple" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"></polygon></svg>}
                                                {item.icon === 'shield' && <svg class="w-6 h-6 text-payflo-blue" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>}
                                            </div>
                                            <div>
                                                <h3 class="font-semibold text-gray-900">{item.title}</h3>
                                                <p class="text-gray-600">{item.desc}</p>
                                            </div>
                                        </div>
                                    ))}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Start Your Journey Section -->
        <section class="section bg-gray-50">
            <div class="container-custom">
                <h2 class="animate-on-scroll delay-0 text-3xl md:text-4xl font-bold text-center mb-16">
                    Start Your <span class="gradient-text">Learning Path</span>
                </h2>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                    {[
                        { title: 'Beginner', desc: 'New to crypto? Start here to learn the foundational concepts with no jargon.', icon: 'seedling' },
                        { title: 'Intermediate', desc: 'You know the basics. Dive deeper into DeFi, security, and how protocols work.', icon: 'rocket' },
                        { title: 'Advanced', desc: 'Explore technical deep-dives, governance structures, and building on USDC.', icon: 'brain' }
                    ].map((path, index) => (
                        <div class={`animate-on-scroll delay-${index+1} feature-card`}>
                            <div class="w-12 h-12 bg-purple-100 rounded-lg flex items-center justify-center mb-5">
                                {path.icon === 'seedling' && <svg class="w-6 h-6 text-payflo-purple" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>}
                                {path.icon === 'rocket' && <svg class="w-6 h-6 text-payflo-purple" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5.5 12.5a7 7 0 0 0 13 0"></path><path d="M21 16V8a2 2 0 0 0-2-2h-3"></path><path d="M3 16V8a2 2 0 0 1 2-2h3"></path><path d="M12 12a4 4 0 0 0-8 0"></path><path d="M12 12a4 4 0 0 1 8 0"></path></svg>}
                                {path.icon === 'brain' && <svg class="w-6 h-6 text-payflo-purple" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 21a9 9 0 0 0 9-9h-9v9Z"></path><path d="M12 12a9 9 0 0 1-9-9h9v9Z"></path><path d="M12 12a9 9 0 0 0 9 9V12h-9Z"></path><path d="M12 12a9 9 0 0 1-9 9V12h9Z"></path></svg>}
                            </div>
                            <h3 class="text-xl font-semibold mb-3">{path.title}</h3>
                            <p class="text-gray-600">{path.desc}</p>
                            <a href="#" class="mt-4 inline-block text-payflo-purple hover:text-payflo-blue font-semibold">View Path →</a>
                        </div>
                    ))}
                </div>
            </div>
        </section>

        <!-- Featured Guides -->
        <section id="featured-guides" class="section">
            <div class="container-custom">
                <h2 class="animate-on-scroll delay-0 text-3xl md:text-4xl font-bold text-center mb-16">
                    Featured <span class="gradient-text">Guides</span>
                </h2>
                <div class="space-y-6">
                    {featuredGuides.map((guide, index) => (
                        <a href={guide.url} class={`animate-on-scroll delay-${index+1} block feature-card hover:shadow-xl transition-shadow`}>
                            <div class="flex items-start gap-6">
                                <div class="w-12 h-12 bg-purple-100 rounded-lg flex items-center justify-center flex-shrink-0">
                                    <svg class="w-6 h-6 text-payflo-purple" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                                </div>
                                <div>
                                    <span class="bg-blue-100 text-payflo-blue px-3 py-1 rounded-full text-xs font-medium mb-3 inline-block">{guide.category}</span>
                                    <h3 class="text-xl font-semibold mb-2">{guide.title}</h3>
                                    <p class="text-gray-600 text-lg">{guide.description}</p>
                                </div>
                            </div>
                        </a>
                    ))}
                </div>
            </div>
        </section>

        <!-- Browse by Category -->
        <section class="section bg-gray-50">
            <div class="container-custom">
                <h2 class="animate-on-scroll delay-0 text-3xl md:text-4xl font-bold text-center mb-16">
                    Browse by <span class="gradient-text">Category</span>
                </h2>
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                    {categories.map((category, index) => (
                        <a href="#" class={`animate-on-scroll delay-${index+1} feature-card text-center hover:shadow-xl transition-shadow`}>
                            <h3 class="text-lg font-semibold">{category}</h3>
                        </a>
                    ))}
                </div>
            </div>
        </section>

        <!-- CTA Section -->
        <section class="section bg-gradient-to-r from-payflo-purple to-payflo-blue">
            <div class="container-custom text-center">
                <h2 class="animate-on-scroll delay-0 text-3xl md:text-4xl font-bold text-white mb-8">
                    Join the Conversation
                </h2>
                <p class="animate-on-scroll delay-1 text-xl text-white/90 mb-10 max-w-2xl mx-auto">
                    Have a question? Want to learn with others? Our community is the best place to ask questions and stay up to date.
                </p>
                <a href="#" class="animate-on-scroll delay-2 btn bg-white text-payflo-purple hover:bg-white/90">
                    Join Our Discord
                </a>
            </div>
        </section>
    </main>
</Layout>
