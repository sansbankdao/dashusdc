---
// src/pages/consumers/index.astro
import Layout from '../../layouts/Layout.astro'
import { Image } from 'astro:assets'
import consumerImage from '../../assets/product-dashboard.webp'
// NEW: Import the corrected, consumer-focused CTA component
import ConsumerCTASection from '../../components/ConsumerCTASection.astro'

const benefits = [
    {
        title: 'Spend Globally, Pay Locally',
        description: `
            Use USDC to shop online, pay for services, or subscribe to content from around the world without worrying about high conversion fees or slow bank transfers.
        `,
    },
    {
        title: 'Send Money Without Borders',
        description: `
            Transfer value to friends and family anywhere in the world in minutes, not days. Bypass the high fees and delays of traditional remittance services.
        `,
    },
    {
        title: 'Protect Your Savings',
        description: `
            Hedge against the volatility of other cryptocurrencies or local currency inflation. USDC maintains a stable 1:1 value with the US Dollar, giving you a reliable store of value.
        `,
    },
    {
        title: 'Enter the World of DeFi',
        description: `
            Use USDC as the stable foundation for your DeFi journey. Lend, borrow, and earn yield on decentralized platforms without exposing yourself to price volatility.
        `,
    },
    {
        title: 'You Are Your Own Bank',
        description: `
            Hold USDC in a self-custody wallet for complete control over your funds. Your assets are secure and cannot be frozen or seized by a third party.
        `,
    },
    {
        title: 'Low Transaction Fees',
        description: `
            Enjoy the power of blockchain with transaction costs that are a fraction of the fees charged by credit cards and traditional banks.
        `,
    }
];
---

<Layout
    title="Bring Dash USDC to Your Community | Onboard Local Merchants"
    description="Empower your favorite local businesses to accept USDC. Learn how you can help grow the Dash USDC ecosystem and earn rewards."
>
    <!-- HERO SECTION: Redesigned for community action -->
    <section class="pt-20 pb-16 md:pt-28 md:pb-24">
        <div class="container-custom">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
                <div class="animate-on-scroll">
                    <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold leading-tight">
                        Bring Digital Dollars to <span class="gradient-text">Your Community</span>
                    </h1>

                    <p class="mt-6 text-xl text-gray-600 max-w-lg">
                        You have the power to expand the USDC network. Help your favorite local shops accept a fast, stable, and low-cost currency.
                    </p>

                    <div class="mt-8 flex flex-col sm:flex-row gap-4">
                        <a href="#onboard" class="btn btn-primary">Onboard a Merchant</a>
                        <a href="#benefits" class="btn btn-secondary">Why USDC?</a>
                    </div>
                </div>

                <div class="animate-on-scroll" style="animation-delay: 0.2s;">
                    <div class="relative">
                        <div class="absolute -inset-0.5 bg-gradient-to-r from-payflo-purple to-payflo-blue rounded-xl blur opacity-30"></div>
                        <div class="relative bg-white rounded-xl shadow-xl overflow-hidden">
                            <Image
                                src={consumerImage}
                                alt="Dash USDC being used in a local community setting"
                                class="w-full h-auto"
                                width={700}
                                height={500}
                            />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- NEW SECTION: How to Onboard a Merchant -->
    <section id="onboard" class="py-20 bg-gray-50/50">
        <div class="container-custom">
            <div class="text-center max-w-3xl mx-auto animate-on-scroll">
                <h2 class="text-3xl md:text-4xl font-bold">
                    Become a <span class="gradient-text">USDC Ambassador</span> in 3 Steps
                </h2>
                <p class="mt-4 text-xl text-gray-600">
                    It’s easy to introduce your favorite businesses to Dash USDC. We provide the tools to make the conversation simple and rewarding.
                </p>
            </div>

            <div class="mt-16 grid grid-cols-1 md:grid-cols-3 gap-8">
                <!-- Step 1 -->
                <div class="bg-white rounded-xl p-8 shadow-sm text-center animate-on-scroll">
                    <div class="mx-auto h-12 w-12 rounded-lg bg-gradient-to-r from-payflo-purple to-payflo-blue flex items-center justify-center text-white mb-6">
                        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
                    </div>
                    <h3 class="text-xl font-semibold">Start the Conversation</h3>
                    <p class="mt-3 text-gray-600">Simply ask if they're open to new payment methods that save them money on fees.</p>
                </div>
                <!-- Step 2 -->
                <div class="bg-white rounded-xl p-8 shadow-sm text-center animate-on-scroll" style="animation-delay: 0.1s">
                    <div class="mx-auto h-12 w-12 rounded-lg bg-gradient-to-r from-payflo-purple to-payflo-blue flex items-center justify-center text-white mb-6">
                        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="12" y1="18" x2="12" y2="12"></line><line x1="9" y1="15" x2="15" y2="15"></line></svg>
                    </div>
                    <h3 class="text-xl font-semibold">Share Resources</h3>
                    <p class="mt-3 text-gray-600">Give them a simple info pack that explains the benefits for their business.</p>
                    <a href="/merchants/info-pack.pdf" class="btn btn-secondary btn-sm mt-4">Download Info Pack</a>
                </div>
                <!-- Step 3 -->
                <div class="bg-white rounded-xl p-8 shadow-sm text-center animate-on-scroll" style="animation-delay: 0.2s">
                    <div class="mx-auto h-12 w-12 rounded-lg bg-gradient-to-r from-payflo-purple to-payflo-blue flex items-center justify-center text-white mb-6">
                        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 12v10H4V12"></path><path d="M16 6l-4-4-4 4"></path><path d="M12 2v13"></path><path d="M20 6h-4.2a2.8 2.8 0 0 0-5.6 0H4"></path></svg>
                    </div>
                    <h3 class="text-xl font-semibold">Earn Rewards</h3>
                    <p class="mt-3 text-gray-600">Our referral program rewards both you and the merchant when they start accepting USDC.</p>
                    <a href="/referral-program" class="btn btn-secondary btn-sm mt-4">Learn More</a>
                </div>
            </div>
        </div>
    </section>

    <!-- This is the existing benefits section, now framed as "Why USDC?" -->
    <section id="benefits" class="py-20">
        <div class="container-custom">
            <div class="text-center max-w-3xl mx-auto animate-on-scroll">
                <h2 class="text-3xl md:text-4xl font-bold">
                    Why You (and Your Merchants) Will Love USDC
                </h2>
                <p class="mt-4 text-xl text-gray-600">
                    USDC offers clear advantages over traditional payment methods for everyone involved.
                </p>
            </div>
            <div class="mt-16 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                {benefits.map((feature, index) => (
                    <div class="bg-white rounded-xl p-8 shadow-sm animate-on-scroll" style={`animation-delay: ${index * 0.1}s`}>
                        <div class="h-12 w-12 rounded-lg bg-gradient-to-r from-payflo-purple to-payflo-blue flex items-center justify-center text-white mb-6">
                            {/* SVG Icons are rendered here as before */}
                            {feature.title === 'Spend Globally, Pay Locally' && <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>}
                            {feature.title === 'Send Money Without Borders' && <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>}
                            {feature.title === 'Protect Your Savings' && <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>}
                            {feature.title === 'Enter the World of DeFi' && <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline><polyline points="17 6 23 6 23 12"></polyline></svg>}
                            {feature.title === 'You Are Your Own Bank' && <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 12V8H6a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v4"></path><path d="M4 6v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8"></path><path d="M18 12a2 2 0 0 0-2 2c0 1.1.9 2 2 2s2-.9 2-2a2 2 0 0 0-2-2z"></path></svg>}
                            {feature.title === 'Low Transaction Fees' && <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M16 8h-6a2 2 0 1 0 0 4h4a2 2 0 1 1 0 4H8"></path><path d="M12 1v2"></path><path d="M12 21v2"></path></svg>}
                        </div>
                        <h3 class="text-xl font-semibold">{feature.title}</h3>
                        <p class="mt-3 text-gray-600">{feature.description}</p>
                    </div>
                ))}
            </div>
        </div>
    </section>

    <!-- Use the new, consumer-focused CTA component -->
    <ConsumerCTASection />
</Layout>
