    <div class="container-custom text-center">
        <h2 class="animate-on-scroll delay-0 text-3xl md:text-4xl font-bold text-white mb-8">
            Ready to Grow the USDC Network?
        </h2>
        <p class="animate-on-scroll delay-1 text-xl text-white/90 mb-10 max-w-2xl mx-auto">
            Start a conversation today and help build a decentralized local economy, one merchant at a time. Download the info pack to get started.
        </p>
        <a
            href="#"
            class="animate-on-scroll delay-2 btn bg-white text-payflo-purple hover:bg-white/90"
        >
            Download Merchant Info Pack
        </a>
    </div>
</section>
