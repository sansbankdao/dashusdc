---
// apps/docs/src/components/MobileNavigation.astro
import Logomark from './Logomark.astro'
import Navigation from './Navigation.astro'

interface Props {
  navigation: {
    title: string
    links: { title: string; href: string }[]
  }[]
  currentPath: string
}

const { navigation, currentPath } = Astro.props
---

<button
  type="button"
  class="relative"
  aria-label="Open navigation"
  data-mobile-nav-open
>
  <svg
    aria-hidden="true"
    viewBox="0 0 24 24"
    fill="none"
    strokeWidth="2"
    strokeLinecap="round"
    class="h-6 w-6 stroke-slate-500"
  >
    <path d="M4 7h16M4 12h16M4 17h16" />
  </svg>
</button>

<div
  class="fixed inset-0 z-50 hidden items-start overflow-y-auto bg-slate-900/50 pr-10 backdrop-blur lg:hidden"
  aria-label="Navigation"
  role="dialog"
  aria-modal="true"
  data-mobile-nav
>
  <div class="min-h-full w-full max-w-xs bg-white px-4 pt-5 pb-12 dark:bg-slate-900 sm:px-6">
    <div class="flex items-center">
      <button
        type="button"
        aria-label="Close navigation"
        data-mobile-nav-close
      >
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          fill="none"
          strokeWidth="2"
          strokeLinecap="round"
          class="h-6 w-6 stroke-slate-500"
        >
          <path d="M5 5l14 14M19 5l-14 14" />
        </svg>
      </button>
      <a href="/" class="ml-6" aria-label="Home page">
        <Logomark class="h-9 w-9" />
      </a>
    </div>
    <Navigation navigation={navigation} currentPath={currentPath} class="mt-5 px-1" />
  </div>
</div>

<script>
  // apps/docs/src/components/MobileNavigation.astro
  const open = document.querySelector('[data-mobile-nav-open]')
  const dialog = document.querySelector<HTMLElement>('[data-mobile-nav]')
  const close = document.querySelector('[data-mobile-nav-close]')

  function setOpen(isOpen: boolean) {
    if (!dialog) return
    dialog.classList.toggle('hidden', !isOpen)
    dialog.classList.toggle('flex', isOpen)
  }

  open?.addEventListener('click', () => setOpen(true))
  close?.addEventListener('click', () => setOpen(false))

  dialog?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => setOpen(false))
  })
</script>
