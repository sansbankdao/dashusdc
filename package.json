{
  "name": "dashusdc",
  "version": "25.9.24",
  "private": true,
  "description": "Dash USDC — a shielded USDC stablecoin on Dash Platform.",
  "license": "MIT",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @dashusdc/web dev",
    "dev:web": "pnpm --filter @dashusdc/web dev",
    "dev:map": "pnpm --filter @dashusdc/map serve",
    "dev:docs": "pnpm --filter @dashusdc/docs dev",
    "build": "pnpm -r build",
    "build:web": "pnpm --filter @dashusdc/web build",
    "build:map": "pnpm --filter @dashusdc/map build",
    "build:docs": "pnpm --filter @dashusdc/docs build",
    "preview:web": "pnpm --filter @dashusdc/web preview"
  }
}